<Project Sdk="Microsoft.NET.Sdk">

  <!-- Limen engine: the authority side of the browser boundary for both
       Summa web pages. Pure F#: state, transitions, request descriptions and
       view projection. No browser, network, clock or file-system access.
       The accounting application decides through Summa's own domain
       (Summa.Ledger) and its storage format (Summa.Storage), both pure. -->

  <ItemGroup>
    <Compile Include="Common.fs" />
    <Compile Include="Backlog.fs" />
    <Compile Include="BacklogPage.fs" />
    <Compile Include="Hub.fs" />
    <Compile Include="HubPage.fs" />
    <Compile Include="Routes.fs" />
    <Compile Include="Accounting.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Summa.Ledger/Summa.Ledger.fsproj" />
    <ProjectReference Include="../Summa.Storage/Summa.Storage.fsproj" />
    <!-- Limen 0.9.0's routing library, vendored until it ships (DF-SUMMA-2026-0010). -->
    <ProjectReference Include="../../vendor/Limen.Routing/Limen.Routing.fsproj" />
  </ItemGroup>
</Project>
