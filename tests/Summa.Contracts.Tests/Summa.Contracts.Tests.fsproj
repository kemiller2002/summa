<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the Chrona-to-Summa contracts package (WI-0017). -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Support.fs" />
    <Compile Include="JsonTests.fs" />
    <Compile Include="GoldenVectorTests.fs" />
    <Compile Include="CodecTests.fs" />
    <Compile Include="PackageTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Summa.Contracts/Summa.Contracts.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
