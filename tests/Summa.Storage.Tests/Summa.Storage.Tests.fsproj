<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of Summa's storage on Arca, against Arca's in-memory provider. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Support.fs" />
    <Compile Include="DeploymentTests.fs" />
    <Compile Include="StorageTests.fs" />
    <Compile Include="AccessTests.fs" />
    <Compile Include="GovernanceTests.fs" />
    <Compile Include="Books.fs" />
    <Compile Include="FinancialRecordsTests.fs" />
    <Compile Include="CommandTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Summa.Storage/Summa.Storage.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EchelonFoundry.Arca.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
