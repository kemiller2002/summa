<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of Summa's financial domain and of the requirement records. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Support.fs" />
    <Compile Include="GapAnalysisTests.fs" />
    <Compile Include="LedgerTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Summa.Ledger/Summa.Ledger.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
