<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of Summa's financial domain and of the requirement records. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Support.fs" />
    <Compile Include="GapAnalysisTests.fs" />
    <Compile Include="LedgerTests.fs" />
    <Compile Include="InvoicingTests.fs" />
    <Compile Include="PaymentsReportsTests.fs" />
    <Compile Include="CreditsTests.fs" />
    <Compile Include="CorrectionsTests.fs" />
    <Compile Include="BillingTests.fs" />
    <Compile Include="ChronaImportTests.fs" />
    <Compile Include="IssuanceTests.fs" />
    <Compile Include="LifecycleTests.fs" />
    <Compile Include="PeriodsTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Summa.Ledger/Summa.Ledger.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
